# Local development (make dev). Prod values come from infra/template.yaml.
AUTH_ISSUER=http://localhost:4400
AUTH_TABLE=auth-service-local
AUTH_DYNAMO_ENDPOINT=http://localhost:8402
AUTH_LOCAL_SIGNER=1
# Any string; make dev prints the curl commands that use it.
AUTH_ADMIN_TOKEN=dev-admin-token
PORT=4400
# Sign in with Google (optional). Create a Web application OAuth client in Google Cloud
# Console with redirect URI http://localhost:4400/v1/login/google/callback for local dev.
#AUTH_GOOGLE_CLIENT_ID=
#AUTH_GOOGLE_CLIENT_SECRET=
